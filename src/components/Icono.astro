---
// Iconografía de Haia (brand book § 8): lineal, geométrica, un solo grosor
// de trazo, retícula 24×24, trazo 1,5 px, esquinas suavemente redondeadas.
// Sin rellenos, sin 3D, sin emojis y sin mezclar librerías: están dibujados aquí.
const { nombre, tam = 24, clase = '' } = Astro.props;

const trazos = {
  alerta: '<path d="M12 4 21 19H3Z"/><path d="M12 10v4"/><path d="M12 16.6v.1"/>',
  documento: '<path d="M14 3H7a1.5 1.5 0 0 0-1.5 1.5v15A1.5 1.5 0 0 0 7 21h10a1.5 1.5 0 0 0 1.5-1.5V7.5Z"/><path d="M14 3v4.5h4.5"/><path d="M9 12.5h6"/><path d="M9 16h4"/>',
  reloj: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  balanza: '<path d="M12 4.5v15"/><path d="M5 7.5h14"/><path d="M8.5 6.8 5.5 14h6Z"/><path d="M15.5 6.8 12.5 14h6Z"/><path d="M8 19.5h8"/>',
  personas: '<circle cx="9" cy="8.5" r="3"/><path d="M3.5 19.5a5.5 5.5 0 0 1 11 0"/><path d="M16 6.2a3 3 0 0 1 0 5.6"/><path d="M17 14.6a5.5 5.5 0 0 1 3.5 4.9"/>',
  calendario: '<rect x="3.5" y="5.5" width="17" height="15" rx="1.5"/><path d="M3.5 10h17"/><path d="M8 3.5v4"/><path d="M16 3.5v4"/>',
  cerebro: '<rect x="6.5" y="6.5" width="11" height="11" rx="2"/><rect x="10" y="10" width="4" height="4" rx="0.5"/><path d="M9.5 3.5v3"/><path d="M14.5 3.5v3"/><path d="M9.5 17.5v3"/><path d="M14.5 17.5v3"/><path d="M3.5 9.5h3"/><path d="M3.5 14.5h3"/><path d="M17.5 9.5h3"/><path d="M17.5 14.5h3"/>',
  enlace: '<path d="M10 14a4 4 0 0 0 5.7 0l2.8-2.8a4 4 0 0 0-5.7-5.7l-1.3 1.3"/><path d="M14 10a4 4 0 0 0-5.7 0l-2.8 2.8a4 4 0 0 0 5.7 5.7l1.3-1.3"/>',
  campana: '<path d="M6.5 10a5.5 5.5 0 0 1 11 0c0 4 1.5 5.5 1.5 5.5H5s1.5-1.5 1.5-5.5Z"/><path d="M10 19a2.2 2.2 0 0 0 4 0"/>',
  grafico: '<path d="M4 4v16h16"/><path d="M8 16v-4"/><path d="M12 16V8"/><path d="M16 16v-6"/>',
  diana: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/>',
  refresco: '<path d="M20 12a8 8 0 1 1-2.6-5.9"/><path d="M20 4v4.5h-4.5"/>',
  cuadricula: '<rect x="3.5" y="3.5" width="7" height="7" rx="1"/><rect x="13.5" y="3.5" width="7" height="7" rx="1"/><rect x="3.5" y="13.5" width="7" height="7" rx="1"/><rect x="13.5" y="13.5" width="7" height="7" rx="1"/>',
  escudo: '<path d="M12 3.5 19.5 6v6c0 4.4-3.1 7.4-7.5 8.5C7.6 19.4 4.5 16.4 4.5 12V6Z"/><path d="M9.2 12.2 11.3 14.3 15 10.6"/>',
  candado: '<rect x="4.5" y="10.5" width="15" height="10" rx="1.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/>',
  nube: '<path d="M7 18.5h10a4 4 0 0 0 .6-7.9A6 6 0 0 0 6.2 9.6 3.9 3.9 0 0 0 7 18.5Z"/>',
  tick: '<path d="M5 12.5 10 17.5 19 7"/>',
  flecha: '<path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>',
  menu: '<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>',
  cerrar: '<path d="M6 6l12 12"/><path d="M18 6 6 18"/>',
  foto: '<rect x="3.5" y="5" width="17" height="14" rx="1.5"/><circle cx="8.5" cy="10" r="1.6"/><path d="M4 16.5 9 12l3.5 3 3-2.5 4.5 4"/>',
  pantalla: '<rect x="3" y="5" width="18" height="12" rx="1.5"/><path d="M9 20h6"/><path d="M12 17v3"/>',
  euro: '<circle cx="12" cy="12" r="8.5"/><path d="M15.5 9.2a4 4 0 1 0 0 5.6"/><path d="M7.5 11h5.5"/><path d="M7.5 13.5h5"/>',
  entrada: '<path d="M14 4h4.5A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5H14"/><path d="M4 12h10"/><path d="M10.5 8 14 12l-3.5 4"/>',
  salida: '<path d="M10 4H5.5A1.5 1.5 0 0 0 4 5.5v13A1.5 1.5 0 0 0 5.5 20H10"/><path d="M10 12h10"/><path d="M16.5 8 20 12l-3.5 4"/>',
  engranaje: '<circle cx="12" cy="12" r="3"/><path d="M12 3v2.5M12 18.5V21M3 12h2.5M18.5 12H21M5.6 5.6l1.8 1.8M16.6 16.6l1.8 1.8M18.4 5.6l-1.8 1.8M7.4 16.6l-1.8 1.8"/>',
  movil: '<rect x="7" y="2.5" width="10" height="19" rx="2"/><path d="M10.5 18.5h3"/>',
};

const d = trazos[nombre] ?? trazos.tick;
---

<svg
  class={`icono ${clase}`}
  width={tam}
  height={tam}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={d}
/>
