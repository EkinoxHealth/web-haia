---
import { r } from '../lib/ruta.js';
import '../styles/haia.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';

const {
  titulo,
  descripcion = 'Haia concilia cada día lo facturado con lo liquidado y cada mes lo cobrado con lo pagado al médico. Servicio para clínicas privadas: datos dentro, resultados fuera.',
} = Astro.props;

// Lo que se ve cuando alguien pega el enlace en WhatsApp, LinkedIn o un correo.
// En JPEG a propósito: hay sitios que todavía no pintan WebP en estas tarjetas.
const imagenSocial = new URL(r('/img/haia-social.jpg'), Astro.site);
const urlCanonica = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />

    <!-- Fuera de los buscadores mientras la web no esté terminada: se llega por
         enlace, pero no se indexa. Quitar las dos líneas al publicar de verdad. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href={r('/img/haia-app-icon.svg')} type="image/svg+xml" />

    <!-- Sin cookies, sin analítica y sin una sola petición fuera de este dominio.
         La tipografía Inter va autoalojada en /fuentes. -->
    <link rel="preload" href={r('/fuentes/inter-latin-400.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={r('/fuentes/inter-latin-300.woff2')} as="font" type="font/woff2" crossorigin />

    <link rel="canonical" href={urlCanonica} />

    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Haia" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:image" content={imagenSocial} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Haia · Software para clínicas. Nació dentro de una." />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
    <a class="salto" href="#contenido">Ir al contenido</a>
    <Cabecera />
    <main id="contenido">
      <slot />
    </main>
    <Pie />

    <!-- Visor de capturas: la única pizca de JavaScript de la web. Sin él la
         página funciona igual, solo que las capturas no se abren en grande. -->
    <dialog id="visor-captura" aria-label="Captura ampliada">
      <div class="visor__caja">
        <img id="visor-img" src="" alt="" />
        <p class="visor__pie">
          <span id="visor-pie"></span>
          <button class="visor__cerrar" type="button" data-cerrar>Cerrar</button>
        </p>
      </div>
    </dialog>

    <script>
      const visor = document.getElementById('visor-captura');
      if (visor && typeof visor.showModal === 'function') {
        const img = document.getElementById('visor-img');
        const pie = document.getElementById('visor-pie');

        document.addEventListener('click', (e) => {
          const boton = e.target.closest('.captura-abrir');
          if (boton) {
            img.src = boton.dataset.captura;
            img.alt = boton.dataset.pie;
            pie.textContent = boton.dataset.pie;
            visor.showModal();
            return;
          }
          // Cerrar con el botón o pinchando fuera de la caja
          if (e.target.closest('[data-cerrar]') || e.target === visor) visor.close();
        });
      }

      // Copiar la dirección de correo, para quien no tenga aplicación de correo.
      // Si el navegador no deja copiar, al menos la deja seleccionada.
      document.addEventListener('click', async (e) => {
        const b = e.target.closest('.copiar');
        if (!b) return;
        const texto = b.dataset.copiar;
        const etiqueta = b.querySelector('span');
        try {
          await navigator.clipboard.writeText(texto);
          const antes = etiqueta.textContent;
          etiqueta.textContent = 'Copiada';
          b.setAttribute('data-copiado', '');
          setTimeout(() => { etiqueta.textContent = antes; b.removeAttribute('data-copiado'); }, 1600);
        } catch (err) {
          const r = document.createRange();
          r.selectNodeContents(etiqueta);
          const sel = getSelection();
          sel.removeAllRanges();
          sel.addRange(r);
        }
      });
    </script>
  </body>
</html>
