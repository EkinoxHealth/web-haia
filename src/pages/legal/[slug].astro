---
import { r } from '../../lib/ruta.js';
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import { legales } from '../../data/legales.js';

export function getStaticPaths() {
  return Object.keys(legales).map((slug) => ({ params: { slug }, props: { t: legales[slug] } }));
}

const { t } = Astro.props;
---

<Base titulo={`${t.titulo} · Haia`} descripcion={t.entradilla}>

  <section class="seccion">
    <div class="contenedor" style="max-width:52rem">
      <p class="rotulo">Legal</p>
      <h1 class="titulo-xl">{t.titulo}</h1>
      <p class="entradilla" style="margin-top:1.25rem">{t.entradilla}</p>

      <div class="aviso-pendiente" style="margin-top:2.5rem">
        <Icono nombre="alerta" tam={20} />
        <span>
          <span class="destacado">Texto pendiente.</span> Este documento existe en borrador, pero
          no se publica hasta que lleve el NIF y los datos registrales de Ekinox Health, S.L. y lo
          haya repasado el abogado. Fuente: {t.doc}.
        </span>
      </div>

      {t.resumen && (
        <div style="margin-top:2.5rem">
          <h2 class="titulo-m">Mientras tanto, lo que ya podemos decir</h2>
          <ul class="lista-marcada" style="margin-top:1rem">
            <li><Icono nombre="tick" tam={18} /><span>Tus datos se tratan <span class="destacado">solo para prestarte el servicio</span>.</span></li>
            <li><Icono nombre="tick" tam={18} /><span>Cada cliente tiene <span class="destacado">su propio espacio</span>, separado del de los demás.</span></li>
            <li><Icono nombre="tick" tam={18} /><span>La infraestructura está <span class="destacado">dentro de la Unión Europea</span>.</span></li>
            <li><Icono nombre="tick" tam={18} /><span>Actuamos como <span class="destacado">encargados del tratamiento</span>, con contrato.</span></li>
            <li><Icono nombre="tick" tam={18} /><span><span class="destacado">No enviamos datos identificativos de pacientes</span> a sistemas de inteligencia artificial.</span></li>
            <li><Icono nombre="tick" tam={18} /><span>Esta web <span class="destacado">no usa cookies ni analítica</span>, y no hace ninguna petición a servidores de terceros.</span></li>
          </ul>
        </div>
      )}

      <div style="margin-top:2.5rem">
        <h2 class="titulo-m">Qué llevará esta página</h2>
        <ul class="lista-marcada" style="margin-top:1rem">
          {t.llevara.map((l) => <li><Icono nombre="documento" tam={18} /><span>{l}</span></li>)}
        </ul>
      </div>

      <p class="texto" style="margin-top:2.5rem">
        <a class="enlace-flecha" href={r('/')}>
          Volver al inicio <Icono nombre="flecha" tam={16} />
        </a>
      </p>
    </div>
  </section>

</Base>
